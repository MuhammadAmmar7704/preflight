{
  "name": "preflight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pre-download compatibility and supply-chain scanner for npm packages",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "scan": "tsx src/index.ts scan",
    "preflight": "bash ./preflight.sh",
    "server": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "semver": "^7.6.3",
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/semver": "^7.5.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
